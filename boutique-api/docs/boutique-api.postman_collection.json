{
  "info": {
    "name": "Boutique API - Gestion d'inventaire",
    "description": "Exécuter d'abord \"POST /api/auth/login\" : le token est stocké automatiquement dans la variable {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentification",
      "item": [
        {
          "name": "POST /api/auth/register - Créer un compte client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ],
              "query": [],
              "variable": []
            },
            "description": "Le rôle est toujours `client`. Un admin se crée avec `npm run create-admin`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Sara\",\n  \"email\": \"sara@test.tn\",\n  \"mot_de_passe\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "POST /api/auth/login - Se connecter (retourne un token JWT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ],
              "query": [],
              "variable": []
            },
            "description": "Se connecter (retourne un token JWT)",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@boutique.tn\",\n  \"mot_de_passe\": \"motdepasse123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', pm.response.json().token);",
                  "}",
                  "pm.test('statut 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/auth/me - Infos de l'utilisateur connecté",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ],
              "query": [],
              "variable": []
            },
            "description": "Infos de l'utilisateur connecté"
          }
        }
      ]
    },
