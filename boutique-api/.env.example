PORT=3000

# Connexion MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=boutique_db
# Mettre true pour une base cloud qui impose TLS (TiDB Cloud, PlanetScale...)
DB_SSL=false

# JWT (changez cette valeur par une chaîne longue et secrète : obligatoire)
JWT_SECRET=change_moi_par_un_secret_long
JWT_EXPIRES_IN=1d

# Origine autorisée par CORS (laisser vide = toutes, à restreindre en production)
CORS_ORIGIN=http://localhost:5173

# Dossier où sont enregistrées les images des produits (défaut : ./uploads).
# En production sur un hébergeur sans disque persistant, utilisez un volume ou un stockage externe.
UPLOAD_DIR=./uploads

# --- v4 : emails de confirmation ---
# Sans SMTP_HOST, les emails sont SIMULÉS (enregistrés et visibles dans Admin > Emails, rien n'est envoyé).
# Pour de vrais emails (ex. Gmail : mot de passe d'application, ou Mailtrap pour tester) :
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=votre.adresse@gmail.com
#SMTP_PASS=mot_de_passe_application
#EMAIL_FROM="Boutique <votre.adresse@gmail.com>"

# --- v4 : webhooks ---
# Par défaut les webhooks vers localhost / réseaux privés sont REFUSÉS (protection SSRF).
# Mettre true uniquement en développement pour tester avec un récepteur local.
WEBHOOK_ALLOW_PRIVATE=false
