PORT=3000

# Connexion MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=boutique_db
# Mettre true pour une base cloud qui impose TLS (TiDB Cloud, PlanetScale...)
DB_SSL=false

# JWT (changez cette valeur par une chaîne longue et secrète : obligatoire)
JWT_SECRET=change_moi_par_un_secret_long
JWT_EXPIRES_IN=1d

# Origine autorisée par CORS (laisser vide = toutes, à restreindre en production)
CORS_ORIGIN=http://localhost:5173
